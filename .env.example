# FBM phase 1 only. Keep the existing Supabase and Amazon SP-API configuration.
# Manual: defaults on in development, off in production. Still requires an admin session.
AMAZON_FBM_MANUAL_SYNC_ENABLED=true
# Automatic creation of new FBM jobs through the protected cron POST. Independent from manual.
AMAZON_FBM_REPORTS_SYNC_ENABLED=false
# CRON_SECRET must be configured locally by the operator (never commit a real secret).
# Pending manual jobs can be recovered when manual is enabled, even with automatic creation off.
